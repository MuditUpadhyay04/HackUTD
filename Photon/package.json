{
  "name": "bts-photon-bot",
  "private": true,
  "type": "module",
  "description": "Backpressure on your phone: text the Photon line for status, alerts and the agents' handoff.",
  "scripts": {
    "start": "node --env-file=.env --import tsx bot.mts",
    "check": "node --env-file-if-exists=.env --import tsx console.mts --check"
  },
  "dependencies": {
    "spectrum-ts": "^12.15.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20.6"
  }
}
