# Copy to .env (never commit it: this repo is public).
# From app.photon.codes > beat-the-shutdown-test > Configure > Credentials (Copy button).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The operator API (apps/api). Same API_TOKEN as the console; leave blank for the local no-auth dev mode.
API_URL=http://127.0.0.1:3001
API_TOKEN=
# Optional: which dataset to report on (id or label). Blank = same default as the console ("test" upload first).
DATASET=
# Optional: auto | software | fpga (default auto).
RUNTIME=
# Optional: link added to texts, e.g. the console's address.
CONSOLE_URL=
# Optional: phone numbers that always get alert texts, E.164, comma separated. Anyone can also text "subscribe".
ALERT_PHONES=
# Optional: how often to check for new problems, in seconds (default 60).
POLL_SECONDS=
