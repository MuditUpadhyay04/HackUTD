# Copy these from app.photon.codes > beat-the-shutdown-test > Configure > Credentials (Copy button).
# Put them in a file named .env next to this one. Never commit .env: this repo is public.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Where the console runs.
CONSOLE_URL=http://localhost:3100
# Optional: which dataset to report on (blank = the console's default).
DATASET=
