# Tiger Data connection URL; retain its TLS/certificate settings. Never commit real credentials.
DATABASE_URL=postgresql://user:password@your-tiger-host:5432/tsdb?sslmode=verify-full
API_HOST=127.0.0.1
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Generate a strong random token and use the same server-only value in Next and Elysia.
API_TOKEN=
# HTTP Basic protection for the Next operator console (username: operator).
OPERATOR_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FX_SESSIONS_DIR=.data/fx-sessions
# Optional administrator-controlled, approved classifier weights/scale/threshold metadata.
# Never supplied through dataset uploads. No trained weights are bundled.
MODEL_METADATA_PATH=
# Optional trusted provider; no model credentials means explicit solver-draft handoffs.
NVIDIA_BASE_URL=
NEMOTRON_MODEL=
NVIDIA_API_KEY=
# Local, nonpersistent development ONLY:
# STORAGE_MODE=memory
# ALLOW_INSECURE_LOCAL=1
