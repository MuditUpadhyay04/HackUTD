# SymbiYosys job for eog_memory (task T1.memory.fv).   bash scripts/formal.sh memory
# Harness: fv_eog_memory.sv, N_FAC = 2, II = 4, one anyconst slot + gated channel. No multiplier is involved
# (numerics.md §5 is shifts and adds only), so no eog_mul file is read.
#
# Split (per-slot state can sit untouched for unbounded time and the low 8 bits of every EMA are invisible at
# the ports, so history-dependent values are not port-only inductive):
#
# prove   (k-induction, -DFV_PROVE) unbounded:
#           stage contract: u_in.ax_* (assumed), u_out.ax_reset/ax_hold/ax_data, u_stage.st_order, st_no_ghost,
#           st_inflight (<= 2), st_cnt, st_link_n, st_link_r, st_ii (II <= 16 after the N_FAC + 8 sweep),
#           st_lat (latency <= 128); H_* header pass-through; C_* copies; M1_zero; Q1_zero; M4_since; M4_shape;
#           M4_run0; M4_norun; M3_hasfmt; M3_has; M3_last; M2_norun; M3_hr_net; M3_hr_f; M3_hr_s; M3_hr_idle.
#           Depth 20: above II_MAX = 16 so st_ii closes even without RTL-internal phase invariants.
# bmc     (from reset, -DFV_BMC) everything above plus the shadow model of slot f_slot:
#           M5_last/emaf/emas/net/has/since and M4_nsr (exact equations every step, which also covers M3 for
#           the first running record after any number of idle records, M1 "no state change for any slot" and
#           M6 slot independence), M2_last/emaf/emas/net (min/max trackers).
#           Depth 48: reset sweep (<= 10 cycles) plus about 9 records at the RTL's II of 3-4 cycles, enough for
#           reset -> idle -> first run -> EMA update -> HIST_RESET -> INVALID/DROPPED/other-slot interleaving.
#           The nsr cap at 64 (FEAT[28] = 16384) is beyond this depth; it is reached by cover64 and by the
#           simulation vectors (long pump-off stretches).
# cover   (-DFV_COVER) short goals, depth 40.
# cover64 (-DFV_COVER64) spec goal "a slot that has run, stopped 64+ records, and run again"; needs
#           1 + 64 + 1 records of one slot after the sweep, depth 240 (at 3 cycles/record).

[tasks]
prove
bmc
cover
cover64

[options]
prove:   mode prove
prove:   depth 20
bmc:     mode bmc
bmc:     depth 48
cover:   mode cover
cover:   depth 40
cover64: mode cover
cover64: depth 240

[engines]
smtbmc yices

[script]
prove:   read_verilog -formal -sv -DFV_PROVE   eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
bmc:     read_verilog -formal -sv -DFV_BMC     eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
cover:   read_verilog -formal -sv -DFV_COVER   eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
cover64: read_verilog -formal -sv -DFV_COVER64 eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
prep -top fv_eog_memory

[files]
../../rtl/eog_defs.svh
../../rtl/eog_memory.sv
../common/eog_fv_props.sv
fv_eog_memory.sv
