# SymbiYosys job for eog_memory (Verify role, task T1.memory.fv).   bash scripts/formal.sh memory
# Harness: fv_eog_memory.sv, spec v4 (spec/modules/eog_memory.md, numerics.md §5, conventions §1-3 and §7, TASKS.md
# answers #1, #43, #44). Instance N_FAC = 2, II = 4; anyconst slot f_slot and anyconst gated channel f_chan. No
# multiplier is involved (numerics.md §5 is shifts and adds), so no eog_mul file is read.
#
# Split. Per-slot state can sit untouched for unbounded time and the low 8 bits of every average never reach the
# ports, so history-dependent values are not port-only inductive: they are checked by bmc from reset. Long
# histories (the FEAT[28] cap, averages over long pump-off stretches, tens of thousands of records) are checked
# bit-exactly by the simulation (tb/memory: Mudit's golden sets g0/g1/g2/g0v0/g2v0, the practice week, synthetic).
#
# prove    (-DFV_PROVE, k-induction, unbounded, free inputs) everything that depends only on the record being
#          output: u_out.ax_reset/ax_hold/ax_data; u_stage.st_order/st_no_ghost/st_inflight (<= 2)/st_cnt/
#          st_link_n/st_link_r/st_ii (II <= 16 after the N_FAC + 8 sweep)/st_lat (latency <= 128); H_* header
#          pass-through; C_feat/C_feat0/C_rules/C_inflow/C_level; M1_zero (every status but VALID/HELD, #44);
#          Q1_zero (#1); M3_has/M3_hasfmt/M3_last/M3_hr_f/M3_hr_s/M3_hr_net (#43)/M3_hr_idle; M4_since/M4_shape/
#          M4_run0/M4_norun (M4_norun also catches an nsr counter that wraps at 255: induction starts from any
#          stored nsr). Depth 20 > II_MAX = 16: st_ii/st_lat close without RTL phase invariants unless the RTL can
#          sit 20 cycles in a hidden non-presenting state (the stub closed at induction length 3).
# bmc      (-DFV_BMC, free inputs: gaps, back-pressure, every status code, FAC 0..31, any int16) everything above
#          plus the shadow of slot f_slot: M5_last, M5_has, M4_nsr (harness nsr counter), M3_first, M3_net0 (#43),
#          M2_norun, M2_last, lemmas L_last/L_clr. With f_slot anyconst the shadow is every slot, and since it
#          absorbs only f_slot's own records (VALID/HELD update, non-DROPPED HIST_RESET clears), this is also M1
#          "DROPPED changes no state, INVALID only by its HIST_RESET, FAC >= N_FAC touches nothing" and M6 slot
#          independence. Depth 18: 5 records after the N_FAC-cycle sweep at II 3 (outputs at steps 5, 8, 11, 14,
#          17), e.g. run, INVALID+HIST_RESET, other slot, FAC >= N_FAC, idle record, in any order and timing.
# bmcarith (-DFV_BMC -DFV_ARITH -DFV_FULLRATE) the averages: M5_emaf/M5_emas (channel f_chan, so every channel),
#          M5_net, M2_emaf/M2_emas/M2_net, lemmas L_ef/L_es/L_clre/L_net/L_net0, plus everything in bmc; one reset,
#          then in_valid = out_ready = 1 (records back to back, the hazard case), data free. Depth 20: 6 records
#          (first value, then updates from states whose hidden low bits are nonzero, other records interleaved).
# cover    (-DFV_COVER, depth 30) first run, EMA update, idle -> run, INVALID, DROPPED, FAC >= N_FAC, both slots,
#          back-pressure, an INVALID HIST_RESET clearing a slot that had run (#44). All reached by step 13.
# cover64  (-DFV_COVER64 -DFV_DEEP, depth 215) the spec's cover: a slot that has run, stopped 64+ records, and run
#          again (~200 cycles at II 3; only PUMP_RUN is free, every value 0). btormc: smtbmc needs > 1 h here.
# bmc64    (-DFV_BMC -DFV_DEEP; after `--`, not in the default run: `sby -f eog_memory.sby bmc64`) the bmc
#          asserts over 64+ record stretches with zero values (M4_nsr through the FEAT[28] cap). ~20 min.
#
# Engines: abc bmc3 for the bmc tasks (5-10x faster than smtbmc here: the cost is proving the DUT's hidden state
# equal to the shadow's, which bit-level SAT does better), smtbmc yices for prove and cover.
# Run times against a throwaway one-record-at-a-time stub (II 3, latency 2, N_FAC-cycle sweep) on the shared WSL box
# (load ~16 of 20 cores): see the T1.memory.fv report.

[tasks]
prove
bmc
bmcarith
cover
cover64
--
bmc64

[options]
prove:    mode prove
prove:    depth 20
bmc:      mode bmc
bmc:      depth 18
bmcarith: mode bmc
bmcarith: depth 20
bmc64:    mode bmc
bmc64:    depth 215
cover:    mode cover
cover:    depth 30
cover64:  mode cover
cover64:  depth 215

[engines]
prove:    smtbmc yices
bmc:      abc bmc3
bmcarith: abc bmc3
bmc64:    abc bmc3
cover:    smtbmc yices
cover64:  btor btormc

[script]
prove:    read_verilog -formal -sv -DFV_PROVE                         eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
bmc:      read_verilog -formal -sv -DFV_BMC                           eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
bmcarith: read_verilog -formal -sv -DFV_BMC -DFV_ARITH -DFV_FULLRATE  eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
bmc64:    read_verilog -formal -sv -DFV_BMC -DFV_DEEP                 eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
cover:    read_verilog -formal -sv -DFV_COVER                         eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
cover64:  read_verilog -formal -sv -DFV_COVER64 -DFV_DEEP             eog_fv_props.sv eog_memory.sv fv_eog_memory.sv
prep -top fv_eog_memory

[files]
../../rtl/eog_defs.svh
../../rtl/eog_memory.sv
../common/eog_fv_props.sv
fv_eog_memory.sv
