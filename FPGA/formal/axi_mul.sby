# SymbiYosys job for axi_mul — open-source Yosys is enough (immediate
# assertions only, no Verific).
#
#   sby -f formal/axi_mul.sby          # all tasks
#   sby -f formal/axi_mul.sby prove    # unbounded proof (k-induction)
#
# prove : AXI4-Lite slave rules + control + datapath plumbing, unbounded.
#         The 32x32 multiplier is abstracted as an uninterpreted function
#         (FORMAL_ABSTRACT_MUL) so induction stays fast.
# bmc   : same properties with the REAL multiplier, checked against the
#         spec  s3_p == f_a * f_b  for every trace up to `depth` cycles
#         (9 cycles = one complete op; deeper runs get slow with z3 because
#         of the 32x32 bvmul — the prove task covers unbounded behaviour).
# cover : shows a full write-A/B -> START -> DONE -> read-back is reachable.

[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 6
bmc:   mode bmc
bmc:   depth 9
cover: mode cover
cover: depth 16

[engines]
smtbmc z3

[script]
prove: read_verilog -formal -DFORMAL_ABSTRACT_MUL axi_mul.v
bmc:   read_verilog -formal axi_mul.v
cover: read_verilog -formal axi_mul.v
prep -top axi_mul

[files]
../rtl/axi_mul.v
