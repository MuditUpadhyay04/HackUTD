[tasks]
prove
bmc
bmc_arith
cover

[options]
prove:     mode prove
prove:     depth 64
bmc:       mode bmc
bmc:       depth 140
bmc_arith: mode bmc
bmc_arith: depth 100
cover:     mode cover
cover:     depth 140

[engines]
prove:     smtbmc yices
bmc:       abc bmc3
bmc_arith: abc bmc3
cover:     smtbmc yices

[script]
prove:     read_verilog -formal -sv -I . -DFV_PROVE eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
bmc:       read_verilog -formal -sv -I .            eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
bmc_arith: read_verilog -formal -sv -I . -DFV_ARITH eog_fv_props.sv eog_mul.sv eog_div.sv eog_countdown.sv fv_eog_countdown.sv
cover:     read_verilog -formal -sv -I . -DFV_COVER eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
prove:     chparam -set II 64 -set II_CHK 0 -set LAT_CHK 0 fv_eog_countdown
prep -top fv_eog_countdown
setundef -anyseq

[files]
../common/eog_fv_props.sv
../common/eog_mul_abstract.sv
eog_div_abstract.sv
../../rtl/eog_defs.svh
../../rtl/eog_mul.sv
../../rtl/eog_div.sv
../../rtl/eog_countdown.sv
fv_eog_countdown.sv
