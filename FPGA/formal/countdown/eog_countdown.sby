[tasks]
prove
prove_one
bmc
bmc_stage
bmc_arith
cover

[options]
prove:     mode prove
prove:     depth 20
prove_one: mode prove
bmc:       mode bmc
bmc:       depth 130
bmc_stage: mode bmc
bmc_stage: depth 150
bmc_arith: mode bmc
bmc_arith: depth 90
cover:     mode cover
cover:     depth 130

[engines]
prove:     smtbmc yices
prove_one: abc pdr
bmc:       abc bmc3
bmc_stage: abc bmc3
bmc_arith: abc bmc3
cover:     smtbmc yices

[script]
prove:     read_verilog -formal -sv -I . -DFV_STAGE -DEOG_FV_RECNO_SEQ=8 eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
prove_one: read_verilog -formal -sv -I . -DFV_PROVE eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
bmc:       read_verilog -formal -sv -I .            eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
bmc_stage: read_verilog -formal -sv -I . -DFV_STAGE eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
bmc_arith: read_verilog -formal -sv -I . -DFV_ARITH eog_fv_props.sv eog_mul.sv eog_div.sv eog_countdown.sv fv_eog_countdown.sv
cover:     read_verilog -formal -sv -I . -DFV_COVER eog_fv_props.sv eog_mul_abstract.sv eog_div_abstract.sv eog_countdown.sv fv_eog_countdown.sv
prove:     chparam -set LAT_CHK 0 fv_eog_countdown
prove_one: chparam -set II 64 -set II_CHK 0 -set LAT_CHK 0 fv_eog_countdown
bmc:       chparam -set PAYLOAD 0 -set N_IB 5 fv_eog_countdown
bmc_stage: chparam -set PAYLOAD 0 fv_eog_countdown
bmc_arith: chparam -set PAYLOAD 0 -set N_IB 5 -set N_LB 11 -set N_KB 15 -set N_SB 10 fv_eog_countdown
cover:     chparam -set PAYLOAD 0 -set N_IB 5 fv_eog_countdown
prep -top fv_eog_countdown
prove_one: chformal -assert -remove *eog_fv_stage *eog_fv_axis
bmc:       chformal -assert -remove *eog_fv_stage *eog_fv_axis
bmc_arith: chformal -assert -remove *eog_fv_stage *eog_fv_axis
cover:     chformal -assert -remove
setundef -anyseq

[files]
../common/eog_fv_props.sv
../common/eog_mul_abstract.sv
eog_div_abstract.sv
../../rtl/eog_defs.svh
../../rtl/eog_mul.sv
../../rtl/eog_div.sv
../../rtl/eog_countdown.sv
fv_eog_countdown.sv
