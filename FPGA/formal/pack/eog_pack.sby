# SymbiYosys job for eog_pack (Verify role, task T1.pack.fv). Properties: fv_eog_pack.sv (K1-K4, B_*, stage
# contract via eog_fv_stage, covers). BATCH = 3 in the harness (spec cover).
#   bash scripts/formal.sh pack          # all tasks, report in reports/formal_pack.txt
#
# prove : unbounded proof of every assertion with abc pdr (IC3). Why not k-induction: the DUT's beat position
#         (and any skid buffer) is invisible at the ports; with m_ready held 0 for any number of cycles a k-step
#         induction trace can start with the DUT's beat counter out of step with the harness's f_beat, so no
#         depth closes without RTL-internal invariants (same situation as formal/unpack). PDR learns them.
# bmc   : smtbmc, every assertion from reset, depth 20 = reset + idle + 4 records' 16 beats (> one BATCH = 3 batch
#         plus the next record) -- quick counterexamples for the RTL author.
# cover : spec cover (a batch of BATCH = 3 results ending in m_last) + sanity covers; depth 24.
# Run times against the verifier's throwaway stub: see the T1.pack.fv report (lead's notes / TASKS.md row).

[tasks]
prove
bmc
cover

[options]
prove: mode prove
bmc:   mode bmc
bmc:   depth 20
cover: mode cover
cover: depth 24

[engines]
prove: abc pdr
bmc:   smtbmc boolector
cover: smtbmc yices

[script]
read_verilog -formal -sv eog_fv_props.sv
read_verilog -formal -sv -I . eog_pack.sv
read_verilog -formal -sv -I . fv_eog_pack.sv
prep -top fv_eog_pack

[files]
../common/eog_fv_props.sv
../../rtl/eog_defs.svh
../../rtl/eog_pack.sv
fv_eog_pack.sv
