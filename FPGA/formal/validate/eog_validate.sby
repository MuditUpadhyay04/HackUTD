# SymbiYosys job for eog_validate (spec/modules/eog_validate.md, numerics.md §3; spec v2). Verify role, task
# T1.validate.fv. Harness and property map: fv_eog_validate.sv (header).
#   bash scripts/formal.sh validate
#
# All tasks: N_FAC = 2, N_WELL = 2 (11 fields per slot), CONFIG rows / GLOBAL anyconst, fac_touch free.
# eog_validate has no multiplier, so there is no abstract model.
#
# prove   k-induction, every handshake schedule, free rst_n, full data widths. Stage contract (handshake, REC_NO
#         order, <= 2 in flight, II <= 16, latency <= 128) and the per-record properties (HDR ST RSN V1 V2 V3_rsn
#         V3_only V4 PRV0 V11 V8_* HR* HLD0 INC_*). -DFV_NO_HIST drops the history properties, which are not
#         k-inductive through a port-only harness (see the harness header). depth 6: the shadow FIFO and the
#         DUT's held record agree within LAT + 2 steps.
# bmc     history properties V3 V5 V6 V7 V9 V10 V12 and REF/V13 (every output bit of the anyconst slot against
#         the harness reference), from reset. -DFV_FAST: in_valid / out_ready held 1 and no reset after cycle 0
#         (one record every II cycles; schedules are covered by `prove`); -DFV_NO_REC: per-record properties are
#         already proven; -DFV_NARROW: data values are 4-bit, TS moves in a 12-bit window (the history logic is
#         about flags, counters and time deltas). depth 14: reset + 6 records at II 2, e.g. observe, hold, hold,
#         lost on one slot with two records of the other slot interleaved.
# bmc_w   the same history properties without REF at full data width (TS wrap-around, 16-bit values, LO/HI
#         limits anywhere). depth 12 (5 records).
# cover   spec cover list (HELD, gap-held, INVALID -> new history, each DROPPED reason) plus vacuity covers
#         for the history properties, every schedule. depth 14.
#
# Run times against a throwaway reference stub (latency 1, II 2), WSL, yices, on a machine shared with other
# proof jobs (load ~20 on 20 cores): see the T1.validate.fv report. The BMC tasks grow ~2.5x per record; if the
# RTL makes them too slow, lower bmc to depth 12 (5 records) before touching anything else.

[tasks]
prove
bmc
bmc_w
cover

[options]
prove: mode prove
prove: depth 6
bmc:   mode bmc
bmc:   depth 14
bmc_w: mode bmc
bmc_w: depth 12
cover: mode cover
cover: depth 14

[engines]
smtbmc yices

[script]
read_verilog -formal -sv eog_fv_props.sv
read_verilog -formal -sv -I . eog_validate.sv
prove: read_verilog -formal -sv -I . -DFV_NO_HIST fv_eog_validate.sv
bmc:   read_verilog -formal -sv -I . -DFV_FAST -DFV_NO_REC -DFV_NARROW fv_eog_validate.sv
bmc_w: read_verilog -formal -sv -I . -DFV_FAST -DFV_NO_REC -DFV_NO_REF fv_eog_validate.sv
cover: read_verilog -formal -sv -I . fv_eog_validate.sv
prep -top fv_eog_validate

[files]
../common/eog_fv_props.sv
../../rtl/eog_defs.svh
../../rtl/eog_validate.sv
fv_eog_validate.sv
