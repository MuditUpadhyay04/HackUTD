# Self-test of the shared checkers (eog_fv_props.sv) and the abstract multiplier on a known-good stage.
#   bash scripts/formal.sh common
# prove: k-induction with the abstract multiplier (depth > DELAY + 2 so the hidden busy state is observed)
# bmc:   real 4x4 multiplier, product checked
# cover: two records complete

[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 8
bmc:   mode bmc
bmc:   depth 16
cover: mode cover
cover: depth 20

[engines]
smtbmc yices

[script]
prove: read_verilog -formal -sv -DFORMAL_ABSTRACT_MUL eog_fv_props.sv eog_mul_abstract.sv fv_selftest.sv
bmc:   read_verilog -formal -sv eog_fv_props.sv mul_real.sv fv_selftest.sv
cover: read_verilog -formal -sv eog_fv_props.sv mul_real.sv fv_selftest.sv
prep -top fv_selftest

[files]
eog_fv_props.sv
eog_mul_abstract.sv
fv_selftest.sv
mul_real.sv
