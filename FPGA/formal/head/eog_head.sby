# SymbiYosys job for eog_head (spec/modules/eog_head.md, numerics.md section 8 with D11/D12; spec v4 + rulings #23,
# #25). Verify role, task T1.head.fv.
#   bash scripts/formal.sh head          # every task; report in reports/formal_head.txt
# Harness: fv_eog_head.sv (property map, parameters and input assumptions in its header).
#
# prove      k-induction, N_FEAT = 31, abstract multiplier, SH = 0 (VER shadow of word 70, wb_raddr assumed 70).
#            Stage contract (handshake, one in / one out in order, II <= 16 at full size, latency <= 128), HDR, CPY,
#            WV, H2_* (swap protocol), H3_ver, RB (VER), RST / SRST_* (hard vs soft reset), H4_zero, H4_nm, H8_when,
#            H8_data, H8_logit(_b) (H8_live is bmc-only, see the harness header).
#            depth 24: must exceed a record's accept-to-output time at N_FEAT = 31 so the tracked record's accept
#            falls inside the induction window (the stub needed 12). Raise it if the RTL's latency is longer, or add
#            internal invariants under ifdef FORMAL.
# bmc_bank   N_FEAT = 3, abstract multiplier, SH = 1 (an anyconst used word, S_OUT, B[0..3], VER of both banks),
#            writes/reads only to those words (WR = 1). RB (so H3 for every used word after a swap back, survival
#            across soft reset, writes ignored in reset), H3_ver, H1 + H6 (H1H6_logit: a record with FEAT = 0 gets
#            sat16((B + rnd) >>> S_OUT) of the bank active at its accept, any B, S_OUT 0..31), plus every prove
#            property. depth 16: hard reset, S_OUT/B/VER writes, a swap, a record with writes and a swap request
#            during it, its output.
# bmc_h7     N_FEAT = 31 (the real window layout), abstract multiplier, SH = 3 (anyconst column i: the 4 words
#            holding W[0..3][i], plus the bank words above; the anyconst RB word ranges over all 71 words), WR = 1.
#            H7_addr (weight addressing), RB / H3 for every window word, plus every prove property. depth 22:
#            hard reset, 4 writes, a swap, a record at N_FEAT = 31 (stub latency 10, RTL v2 latency 12).
# bmc_arith  N_FEAT = 3, real rtl/eog_mul.sv, SH = 2 (every word holding a used weight), features 0 or 2^j
#            (j <= 14: one-hot 32-bit sign extension keeps the multiplier equivalence cheap), weights free:
#            H1 + H5 (H1H5_logit: 64-bit harness sum of every term W[k][i] * FEAT[i] + B[k]), H6 at |acc| beyond
#            32 bits, wiring of W[k][i] to FEAT[i], weight sign extension. Negative features, the full-width
#            accumulator (N_FEAT = 31 needs 66 window writes before the first record) and S_OUT corner values on
#            real data are covered by simulation. depth 12.
# cover      N_FEAT = 3, real multiplier, SH = 2: C_swap, C_sat, C_sat5, C_nomodel, C_coalesce, C_rb, C_srst, C_dbg.
#            depth 20.
# The bmc/cover tasks flatten memories (memory_map): with SMT arrays the per-step time doubled every step.
# Run times against the verifier's throwaway stub (WSL, bitwuzla, shared machine): in the task hand-off.

[tasks]
prove
bmc_bank   bmc
bmc_h7     bmc
bmc_arith  bmc
cover

[options]
prove:     mode prove
prove:     depth 24
bmc:       mode bmc
bmc_bank:  depth 16
bmc_h7:    depth 22
bmc_arith: depth 12
cover:     mode cover
cover:     depth 20

[engines]
smtbmc bitwuzla

[script]
prove:     read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_bank:  read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_h7:    read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_arith: read_verilog -formal -sv -I . eog_mul.sv
cover:     read_verilog -formal -sv -I . eog_mul.sv
read_verilog -formal -sv -I . eog_fv_props.sv
read_verilog -formal -sv -I . eog_head.sv
read_verilog -formal -sv -I . fv_eog_head.sv
prove:     chparam -set N_FEAT 31 -set SH 0 -set MUL_REAL 0 -set H8_LIVE 0 fv_eog_head
bmc_bank:  chparam -set N_FEAT 3  -set SH 1 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_h7:    chparam -set N_FEAT 31 -set SH 3 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_arith: chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 3 fv_eog_head
cover:     chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 3 fv_eog_head
prep -top fv_eog_head
bmc:       memory_map
bmc:       opt -fast
cover:     memory_map
cover:     opt -fast

[files]
../common/eog_fv_props.sv
../common/eog_mul_abstract.sv
../../rtl/eog_defs.svh
../../rtl/eog_mul.sv
../../rtl/eog_head.sv
fv_eog_head.sv
