# SymbiYosys job for eog_head (spec/modules/eog_head.md, numerics.md section 8 with D11/D12; spec v4 + rulings #23,
# #25). Verify role, task T1.head.fv.
#   bash scripts/formal.sh head          # every task; report in reports/formal_head.txt
# Harness: fv_eog_head.sv (property map, parameters and input assumptions in its header).
#
# prove      k-induction, N_FEAT = 31, abstract multiplier, SH = 0 (VER shadow of word 70, wb_raddr assumed 70).
#            Stage contract (handshake, one in / one out in order, II <= 16 at full size, latency <= 128), HDR, CPY,
#            WV, H2_* (swap protocol), H3_ver, RB (VER), RST / SRST_* (hard vs soft reset), H4_zero, H4_nm, H8_when,
#            H8_data, H8_hold, H8_logit (H8_once, H8_logit_b, H8_live are bmc-only: H8_HIST).
#            depth 24: must exceed a record's accept-to-output time at N_FEAT = 31 so the tracked record's accept
#            falls inside the induction window (stub latency 10, induction closed at 12; RTL latency 12). Raise it
#            if the RTL's latency is longer, or add internal invariants under ifdef FORMAL.
# bmc_bank   N_FEAT = 3, abstract multiplier, SH = 1 (an anyconst used word, S_OUT, B[0..3], VER of both banks),
#            writes/reads only to those words (WR = 1). RB (so H3 for every used word after a swap back, survival
#            across soft reset, writes ignored in reset), H3_ver, H1 + H6 (H1H6_logit: a record with FEAT = 0 gets
#            sat16((B + rnd) >>> S_OUT) of the bank active at its accept, any B, every S_OUT 0..31), H8_live, plus
#            every prove property. depth 16: hard reset, S_OUT/B/VER writes, a swap, a record with writes and a swap
#            request during it, its output.
# bmc_rb     N_FEAT = 31 (the full 71-word window), abstract multiplier, SH = 1, WR = 1: RB / H3 / survival across
#            soft reset for an anyconst word anywhere in 0..70. depth 8: write, swap, write, swap back, read.
# bmc_h7     N_FEAT = 3, REAL rtl/eog_mul.sv, SH = 3 (anyconst column i < 3: the 4 words holding W[0..3][i], at the
#            blob stride of 31 halves per class, so classes 1 and 3 start in a word's high half), WR = 1, features
#            0 or 2^j (j <= 14), S_OUT in {0, 16, 31}. With only feature i nonzero every class is predicted:
#            W[k][i] = 0 -> H7_addr (the weight came from byte 8 + 2(31k + i) and nowhere else), W[k][i] != 0 ->
#            H1H5_logit with the real product (B + W*F exact in 64 bits; S_OUT 31 exposes accumulator bits 31+).
# bmc_arith  N_FEAT = 3, eog_mul_unit.sv (exact when an operand is 0 or +-1, free otherwise), SH = 2 (every used
#            weight word), features in {0, 1, -1}, S_OUT in {0, 16, 31}: H1H5_logit for sums of all three terms
#            per class (accumulation across terms and MAC cycles, feature and weight sign handling, B + sum beyond
#            32 bits), H1H6_logit.
#            The first logit prediction falls at the step where the cover task reaches C_sat5: 11 on eog_head
#            5358207 (8 on the verifier's stub); the depth must exceed it or the check is vacuous. bmc_h7 depth 13
#            checks steps 11 and 12 (37 min on 5358207); bmc_arith depth 12 checks step 11 (its step 11 took
#            15 min, step 12 had not finished after 30 min). If the RTL's latency changes, keep each depth above
#            the new C_sat5 step. A symbolic S_OUT next to a nonzero-term sum, or a second multiplier in the
#            harness, did not finish one prediction step in 10 min on the stub.
#            Full-width accumulation (N_FEAT = 31 needs 66 window writes first), negative features with the real
#            multiplier and every S_OUT on real data are covered by simulation (tb/head).
# cover      N_FEAT = 3, real multiplier, SH = 2, features 0 or 2^j: C_swap, C_sat, C_sat5, C_nomodel, C_coalesce,
#            C_rb, C_srst, C_dbg. depth 20 (all reached by step 16 on eog_head 5358207, by 12 on the stub).
# The bmc/cover tasks flatten memories (memory_map): with SMT arrays the per-step time doubled every step.
# Run times against the verifier's throwaway stub (WSL, bitwuzla, shared machine): in the task hand-off.

[tasks]
prove
bmc_bank   bmc
bmc_rb     bmc
bmc_h7     bmc
bmc_arith  bmc
cover

[options]
prove:     mode prove
prove:     depth 24
bmc:       mode bmc
bmc_bank:  depth 16
bmc_rb:    depth 8
bmc_h7:    depth 13
bmc_arith: depth 12
cover:     mode cover
cover:     depth 20

[engines]
smtbmc bitwuzla

[script]
prove:     read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_bank:  read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_rb:    read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_h7:    read_verilog -formal -sv -I . eog_mul.sv
bmc_arith: read_verilog -formal -sv -I . eog_mul_unit.sv
cover:     read_verilog -formal -sv -I . eog_mul.sv
read_verilog -formal -sv -I . eog_fv_props.sv
read_verilog -formal -sv -I . eog_head.sv
read_verilog -formal -sv -I . fv_eog_head.sv
prove:     chparam -set N_FEAT 31 -set SH 0 -set MUL_REAL 0 -set H8_HIST 0 fv_eog_head
bmc_bank:  chparam -set N_FEAT 3  -set SH 1 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_rb:    chparam -set N_FEAT 31 -set SH 1 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_h7:    chparam -set N_FEAT 3  -set SH 3 -set WR 1 -set MUL_REAL 1 -set FSET 3 -set SOUT_SET 1 fv_eog_head
bmc_arith: chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 5 -set SOUT_SET 1 fv_eog_head
cover:     chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 3 fv_eog_head
prep -top fv_eog_head
bmc:       memory_map
bmc:       opt -fast
cover:     memory_map
cover:     opt -fast

[files]
../common/eog_fv_props.sv
../common/eog_mul_abstract.sv
../../rtl/eog_defs.svh
../../rtl/eog_mul.sv
../../rtl/eog_head.sv
eog_mul_unit.sv
fv_eog_head.sv
