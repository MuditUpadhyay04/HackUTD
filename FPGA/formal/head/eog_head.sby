# SymbiYosys job for eog_head (spec/modules/eog_head.md, numerics.md section 8; spec v3). Verify role, task T1.head.fv.
#   bash scripts/formal.sh head          # every task; report in reports/formal_head.txt
# Harness: fv_eog_head.sv (property map, parameters and input assumptions in its header).
#
# prove      k-induction, N_FEAT = 31, abstract multiplier, SH = 0 (VER shadow of word 68, wb_raddr assumed 68).
#            Stage contract (handshake, one in / one out in order, II <= 16 at full size, latency <= 128), HDR, CPY,
#            WV, H2_* (swap protocol), H3_ver, RB (VER bits), RST / SRST_* (hard vs soft reset), H4_zero, H4_nm.
#            depth 24: must exceed a record's accept-to-output time at N_FEAT = 31 so the tracked record's accept
#            falls inside the induction window (the stub needed 12). Raise it if the RTL's latency is longer, or add
#            internal invariants under ifdef FORMAL.
# bmc_bank   N_FEAT = 3, abstract multiplier, SH = 1 (an anyconst used word, B[0..3] and word 68 of both banks),
#            writes/reads only to those words (WR = 1). RB (every used word, so H3 for every word after a swap
#            back, and survival across soft reset), H3_ver, H1 + H6 (H1H6_logit: a record with FEAT = 0 gets
#            sat16((B + rnd) >>> S_OUT) of the bank active at its accept, any B, S_OUT 0..31), plus every prove
#            property. depth 16: hard reset, B + word-68 writes, a swap, a record with writes and a swap request
#            during it, its output.
# bmc_rb     N_FEAT = 31 (the full image layout), abstract multiplier, SH = 1 with the anyconst word anywhere in
#            0..68: RB / H3 for every address of the real image. depth 10: write, swap, write, swap back, read.
# bmc_arith  N_FEAT = 3, real rtl/eog_mul.sv, SH = 2 (all 13 used words), features in {0, 1, -1, 32767, -32768},
#            weights free: H1 + H5 (H1H5_logit, 64-bit harness sum of every term W[k][i] * FEAT[i] + B[k]) and
#            H6 at |acc| beyond 32 bits, wiring of W[k][i] to FEAT[i], sign extension. depth 12: hard reset, the
#            4 words of one class, a swap, a record at N_FEAT = 3. Full-width (N_FEAT = 31) accumulator range is
#            covered by simulation (it needs >= 18 weight writes before the first record: too deep for bmc).
# cover      N_FEAT = 3, real multiplier, SH = 2: C_swap, C_sat, C_sat5, C_nomodel, C_coalesce, C_rb, C_srst.
#            depth 20 (every cover reached by step 13 on the stub).
# The bmc/cover tasks flatten memories (memory_map): with SMT arrays the per-step time doubled every step.
# Run times against the verifier's throwaway stub (WSL, bitwuzla, shared machine): in the task hand-off.

[tasks]
prove
bmc_bank   bmc
bmc_rb     bmc
bmc_arith  bmc
cover

[options]
prove:     mode prove
prove:     depth 24
bmc:       mode bmc
bmc_bank:  depth 16
bmc_rb:    depth 10
bmc_arith: depth 12
cover:     mode cover
cover:     depth 20

[engines]
smtbmc bitwuzla

[script]
prove:     read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_bank:  read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_rb:    read_verilog -formal -sv -I . eog_mul_abstract.sv
bmc_arith: read_verilog -formal -sv -I . eog_mul.sv
cover:     read_verilog -formal -sv -I . eog_mul.sv
read_verilog -formal -sv -I . eog_fv_props.sv
read_verilog -formal -sv -I . eog_head.sv
read_verilog -formal -sv -I . fv_eog_head.sv
prove:     chparam -set N_FEAT 31 -set SH 0 -set MUL_REAL 0 fv_eog_head
bmc_bank:  chparam -set N_FEAT 3  -set SH 1 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_rb:    chparam -set N_FEAT 31 -set SH 1 -set WR 1 -set MUL_REAL 0 fv_eog_head
bmc_arith: chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 2 fv_eog_head
cover:     chparam -set N_FEAT 3  -set SH 2 -set MUL_REAL 1 -set FSET 2 fv_eog_head
prep -top fv_eog_head
bmc:       memory_map
bmc:       opt -fast
cover:     memory_map
cover:     opt -fast

[files]
../common/eog_fv_props.sv
../common/eog_mul_abstract.sv
../../rtl/eog_defs.svh
../../rtl/eog_mul.sv
../../rtl/eog_head.sv
fv_eog_head.sv
