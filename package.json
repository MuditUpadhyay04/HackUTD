{
  "name": "beat-the-shutdown",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "frontend"],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd frontend dev --hostname 127.0.0.1",
    "demo": "bun scripts/demo.ts",
    "build:web": "bun run --cwd frontend build",
    "test": "bun test apps/api packages --timeout 30000",
    "typecheck": "bunx tsc --noEmit -p apps/api/tsconfig.json",
    "db:migrate": "bun apps/api/src/infrastructure/database/migrate.ts"
  },
  "devDependencies": { "@types/bun": "^1.3.0", "typescript": "^5.9.0" }
}
